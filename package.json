{
  "name": "mkelley33",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.ts",
    "build:ci": "tsx scripts/ci-build.ts",
    "gate": "pnpm run format:check && pnpm run typecheck && pnpm run lint:check && pnpm run test:coverage:check",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --config eslint.config.mjs --fix",
    "lint:check": "eslint . --max-warnings=0 --config eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --reporter=dot --silent",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:test": "playwright test",
    "payload": "payload",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:types": "tsx scripts/generate-types.mjs",
    "generate:importmap": "payload generate:importmap",
    "db:backup": "tsx --env-file-if-exists=.env.local scripts/db-backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env.local scripts/db-restore.ts",
    "seed:first-user": "tsx --env-file-if-exists=.env.local scripts/seed-first-user.ts",
    "seed:services": "tsx --env-file-if-exists=.env.local scripts/seed-services.ts",
    "prepare": "husky",
    "test:coverage:check": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@marsidev/react-turnstile": "^1.5.3",
    "@payloadcms/db-mongodb": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-vercel-blob": "^3.86.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "cmdk": "^1.1.1",
    "graphql": "^16.14.2",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "payload": "^3.86.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow-functions": "^3.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "tsx": "4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vercel": "^57.0.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "tsc-files --noEmit types/vitest.d.ts",
      "eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
